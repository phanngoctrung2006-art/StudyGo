# ==============================================================================
# Dockerfile dành riêng cho Web App (Tomcat 10.1 kết nối MySQL ngoài/Docker network)
# ==============================================================================
FROM maven:3.9.9-eclipse-temurin-21 AS build

WORKDIR /app

COPY pom.xml .
RUN mvn dependency:go-offline -B || true

COPY src ./src
RUN mvn clean package -DskipTests -B

FROM tomcat:10.1-jdk21-temurin

LABEL maintainer="Phan Ngoc Trung - 24110366"
LABEL description="Standalone Tomcat 10.1 Web Container for KTGiuaKi"

RUN rm -rf /usr/local/tomcat/webapps/*

COPY --from=build /app/target/KTGiuaKi-1.1.war /usr/local/tomcat/webapps/ROOT.war
COPY --from=build /app/target/KTGiuaKi-1.1.war /usr/local/tomcat/webapps/KTGiuaKi.war

EXPOSE 8080

CMD ["catalina.sh", "run"]
