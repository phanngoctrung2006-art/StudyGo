# ==============================================================================
# Dockerfile Web App (Tomcat 10.1 ket noi MySQL ngoai)
# ==============================================================================
FROM maven:3.9.9-eclipse-temurin-21 AS build

WORKDIR /app

COPY pom.xml .
RUN mvn dependency:go-offline -B || true

COPY src ./src
RUN mvn clean package -DskipTests -B

FROM tomcat:10.1-jdk21-temurin

LABEL maintainer="Phan Ngoc Trung - 24110366"
LABEL description="Standalone Tomcat 10.1 Web Container for KTGiuaKi"

RUN rm -rf /usr/local/tomcat/webapps/*

# Chi mot WAR duy nhat, truy cap tai /
COPY --from=build /app/target/KTGiuaKi-1.1.war /usr/local/tomcat/webapps/ROOT.war

# Gioi han RAM cho goi Free 512MB
ENV CATALINA_OPTS="-Xms64m -Xmx256m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC -Xss512k"

EXPOSE 8080

CMD ["catalina.sh", "run"]